# 复制本文件为 .env 并填写你的密钥（.env 已被 gitignore，不会提交到仓库）。
# Docker Compose 也会在运行时读取该文件；它不会被复制进镜像。

# LLM 提供方配置（默认 DeepSeek）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# JD/简历结构化抽取不需要推理，V4 模型默认关闭思考以降低延迟。
LLM_THINKING_ENABLED=false

# 非 Docker 本地运行默认使用项目根目录下的 SQLite。
# Docker Compose 会覆盖为 /app/data/jobpilot.db，并通过命名卷持久化，无需在此修改。
# DATABASE_URL=sqlite:///./jobpilot.db
AUTO_CREATE_TABLES=false

# RAG 本地索引配置
# Docker Compose 会覆盖为 /app/data/chroma，并与 SQLite 使用同一个持久化卷。
RAG_CHROMA_PATH=./data/chroma
RAG_COLLECTION_NAME=jobpilot_knowledge
RAG_BUILTIN_COLLECTION_NAME=jobpilot_builtin_knowledge
# 导入内置资料后，由 scripts/import_builtin_knowledge.py 输出；多个 ID 用逗号分隔。
RAG_BUILTIN_DOCUMENT_IDS=
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MAX_UPLOAD_BYTES=2097152
RAG_MAX_DISTANCE=0.45
RAG_ANSWER_TOP_K=5
RAG_PLAN_TOP_K=5
RAG_PLAN_CONTEXT_CHARS=30000
RAG_PLAN_PROMPT_VERSION=study-plan-rag-v1
RAG_PLAN_TIME_BUDGET_SECONDS=120.0

RESUME_MAX_UPLOAD_BYTES=5242880
RESUME_MAX_PDF_PAGES=20
RESUME_MAX_TEXT_CHARS=100000
