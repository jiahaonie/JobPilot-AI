# 复制本文件为 .env 并填写你的密钥（.env 已被 gitignore，不会提交到仓库）

# LLM 提供方配置（默认 DeepSeek）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# 数据库（默认项目根目录 SQLite，一般无需修改）
# DATABASE_URL=sqlite:///./jobpilot.db

# RAG 本地索引配置
RAG_CHROMA_PATH=./data/chroma
RAG_COLLECTION_NAME=jobpilot_knowledge
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MAX_UPLOAD_BYTES=2097152
RAG_MAX_DISTANCE=0.45
RAG_ANSWER_TOP_K=5
